LLM_PROVIDER=ollama
# Host Ollama (default). App container reaches it via host.docker.internal.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

GITHUB_WEBHOOK_SECRET=replace-me
IDEMPOTENCY_BACKEND=memory
# For docker compose app service, compose overrides these to redis://redis:6379
# REDIS_URL=redis://127.0.0.1:6379

OPEN_PR=false
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name

PORT=3000
HOST=0.0.0.0
