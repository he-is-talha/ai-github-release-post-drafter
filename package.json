    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
