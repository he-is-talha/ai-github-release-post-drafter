{
  "name": "ai-github-release-post-drafter",
  "version": "1.0.0",
  "description": "GitHub release webhook → schema-locked draft posts",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
